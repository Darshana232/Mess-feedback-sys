# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/mess-feedback
# For MongoDB Atlas cloud:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mess-feedback

# Server Configuration
PORT=5001
NODE_ENV=development

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret (Use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5175

# File Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=./uploads

# Environment
DEBUG=false
LOG_LEVEL=info
